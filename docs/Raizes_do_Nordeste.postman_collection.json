{
  "info": {
    "name": "Raízes do Nordeste API - Coleção de Testes",
    "description": "Coleção Postman v2.1 com os cenários obrigatórios T01 a T10. Autora: Giselle Nunes (RU: 4753682).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080", "type": "string" },
    { "key": "token", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "T01 - Login válido (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "if (json.token) { pm.collectionVariables.set('token', json.token); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"cliente@raizesdonordeste.com.br\",\n  \"senha\": \"Cliente@123\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        }
      ]
    },
    {
      "name": "Unidades e Produtos",
      "item": [
        {
          "name": "Listar Unidades",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/unidades"
          }
        },
        {
          "name": "Listar Produtos",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/produtos"
          }
        }
      ]
    },
    {
      "name": "Pedidos",
      "item": [
        {
          "name": "T05 - Criação de pedido válida com canalPedido (201)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"canalPedido\": \"APP\",\n  \"unidadeId\": 1,\n  \"itens\": [\n    { \"produtoId\": 1, \"quantidade\": 2 }\n  ]\n}"
            },
            "url": "{{baseUrl}}/pedidos"
          }
        },
        {
          "name": "T10 - Consulta de pedidos filtrada por canal (200)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/pedidos?canalPedido=APP&page=1&limit=10"
          }
        }
      ]
    },
    {
      "name": "Pagamentos Mock",
      "item": [
        {
          "name": "T08 - Pagamento mock aprovado (200)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pedidoId\": 1,\n  \"metodo\": \"PIX\",\n  \"simularRecusa\": false\n}"
            },
            "url": "{{baseUrl}}/pagamentos/mock"
          }
        },
        {
          "name": "T09 - Pagamento mock recusado (200)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pedidoId\": 1,\n  \"metodo\": \"CARTAO\",\n  \"simularRecusa\": true\n}"
            },
            "url": "{{baseUrl}}/pagamentos/mock"
          }
        }
      ]
    },
    {
      "name": "Fidelidade",
      "item": [
        {
          "name": "Consultar pontos de fidelidade",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/fidelidade"
          }
        }
      ]
    },
    {
      "name": "Cenarios Negativos",
      "item": [
        {
          "name": "T02 - Acesso sem token (401)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/pedidos"
          }
        },
        {
          "name": "T03 - Acesso sem permissão (403)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/usuarios"
          }
        },
        {
          "name": "T04 - Campo canalPedido ausente ou inválido (422)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"canalPedido\": \"INVALIDO\",\n  \"unidadeId\": 1,\n  \"itens\": [{ \"produtoId\": 1, \"quantidade\": 1 }]\n}"
            },
            "url": "{{baseUrl}}/pedidos"
          }
        },
        {
          "name": "T06 - Produto ou unidade inexistente (404)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"canalPedido\": \"APP\",\n  \"unidadeId\": 9999,\n  \"itens\": [{ \"produtoId\": 1, \"quantidade\": 1 }]\n}"
            },
            "url": "{{baseUrl}}/pedidos"
          }
        },
        {
          "name": "T07 - Estoque insuficiente (409)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"canalPedido\": \"APP\",\n  \"unidadeId\": 1,\n  \"itens\": [{ \"produtoId\": 1, \"quantidade\": 99999 }]\n}"
            },
            "url": "{{baseUrl}}/pedidos"
          }
        }
      ]
    }
  ]
}

